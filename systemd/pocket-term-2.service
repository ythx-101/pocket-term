[Unit]
Description=pocket-term-2 bridge (herdr chat SPA, read-only)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/pocket-term-2
# Optional overrides (defaults: 127.0.0.1:7690, herdr.sock under ~/.config/herdr):
# Environment=PT2_HOST=127.0.0.1
# Environment=PT2_PORT=7690
# Environment=PT2_HERDR_SOCK=/root/.config/herdr/herdr.sock
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
